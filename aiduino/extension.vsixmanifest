			<Tags>arduino,arduinoIDE,ai,claude,chatgpt,gemini,mistral,perplexity,groq,cohere,debug,error,help,assistant,ollama,embedded,platformio,iot,microcontroller,local llm,keybindings</Tags>
			<Categories>Other,Debuggers,Education</Categories>
			<GalleryFlags>Public</GalleryFlags>
			
			<Properties>
				<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.60.0" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
